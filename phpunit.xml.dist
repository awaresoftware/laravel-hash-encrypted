<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!--
            These mirror the values that tests/TestCase.php sets through the config
            repository. They are declared here as well so that the required
            environment contract is visible in one place for consumers copying
            this file, and so a missing APP_KEY fails loudly.
        -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AkbpbnbQXPvNR2SJvdzHSGKYZdLNFzRDmj/p7QgFR5M="/>
        <env name="APP_KEY_ID" value="1"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>

        <!-- Deterministic keys: blind index assertions depend on them. -->
        <env name="CRYPTO_ENCRYPTION_KEY_ID" value="1"/>
        <env name="CRYPTO_ENCRYPTION_KEY" value="base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="/>
        <env name="CRYPTO_PREVIOUS_KEYS" value=""/>
        <env name="CRYPTO_HASH_KEY" value="base64:YmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmI="/>
        <env name="CRYPTO_BLIND_INDEX_STRATEGY" value="auto"/>
    </php>
</phpunit>